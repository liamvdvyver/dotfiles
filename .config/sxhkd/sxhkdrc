# Applications ------------------------------------------------------------  {{{

super + w
    qutebrowser

super + shift + w
    brave --password-store=basic

super + e
    emacsclient -c -a emacs -n

super + f
    tmux new-window yazi

# }}}

# Shortcuts ---------------------------------------------------------------- {{{

Print
    flameshot gui && killall flameshot

super + shift + x
    xkill

super + Escape
    dunstctl close-all

super + p
    usermenu -p system -e

# }}}

# Dmenu -------------------------------------------------------------------- {{{

super + d
    rofi -show-icons -show drun

super + shift + p
    usermenu

super + shift + u
    usermenu --user

super + shift + v
    autorandr -c docked

super + v
    autorandr -c mobile

super + shift + i
    kmonad-selector

super + shift + s
    system-menu

# }}}

# Media -------------------------------------------------------------------- {{{

# Media keys

XF86AudioRaiseVolume
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+

XF86AudioLowerVolume
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-

XF86AudioMute
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

XF86AudioMicMute
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

XF86AudioPlay
    playerctl play-pause

XF86AudioNext
    playerctl next

XF86AudioPrev
    playerctl previous

XF86MonBrightnessUp
    brightnessctl set +10%

XF86MonBrightnessDown
    brightnessctl set 10%-

# }}}

# XWMUX -------------------------------------------------------------------- {{{

super + h
    tmux select-pane -L

super + j
    tmux select-pane -D

super + k
    tmux select-pane -U

super + l
    tmux select-pane -R

super + 1
    tmux select-window -t 1

super + 2
    tmux select-window -t 2

super + 3
    tmux select-window -t 3

super + 4
    tmux select-window -t 4

super + 5
    tmux select-window -t 5

super + 6
    tmux select-window -t 6

super + 7
    tmux select-window -t 7

super + 8
    tmux select-window -t 8

super + 9
    tmux select-window -t 9

super + shift + 1
    tmux join-pane -t 1.

super + shift + 2
    tmux join-pane -t 2.

super + shift + 3
    tmux join-pane -t 3.

super + shift + 4
    tmux join-pane -t 4.

super + shift + 5
    tmux join-pane -t 5.

super + shift + 6
    tmux join-pane -t 6.

super + shift + 7
    tmux join-pane -t 7.

super + shift + 8
    tmux join-pane -t 8.

super + shift + 9
    tmux join-pane -t 9.

super + c
    tmux send-keys -K 'C-b' 'c'

super + s
    tmux run-shell tmux-sessioniser-popup

super + o
    tmux run-shell tmux-move

super + shift + o
    tmux run-shell tmux-link

super + m
    tmux swap-pane -t 0 && tmux select-pane -t 0

super + n
    tmux new-window nmtui

super + a
    tmux new-window pulsemixer

super + b
    tmux new-window bluetui

super + shift + l
    tmux switch-client -l

super + shift + j
    tmux swap-pane -D && xwmux-report.sh

super + shift + k
    tmux swap-pane -U && xwmux-report.sh

super + x
    xwmux-ctl kill-pane focused

super + Return
    tmux send-keys -K 'C-b' 'Enter'

super + control + w
        tmux-find 'qutebrowser'

super + control + v
        tmux-find 'nvim'

super + control + r
        tmux-find 'ranger'

super + control + s
        tmux-find 'ncspot'

super + control + z
        tmux-find 'zsh'

super + control + a
        tmux-find 'pi'

super + comma
        notify-send prev && xwmux-ctl focus-monitor prev

super + period
        notify-send next && xwmux-ctl focus-monitor next
# }}}
